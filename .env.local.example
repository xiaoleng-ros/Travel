# 本地开发环境变量（复制为 .env.local 后按需修改；.env.local 已被 git 忽略）

# JWT 密钥（32 位以上随机串）
# 生成: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-secret-please-change-to-32-chars-or-more

# 首次启动时创建的管理员初始密码（默认 123456）
ADMIN_INITIAL_PASSWORD=123456

# 数据库：留空 = 本地 SQLite 文件 ./api-dev.db（零配置）
# 生产环境填 Turso 连接串，形如 libsql://your-db-yourorg.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 七牛云 Kodo（新加坡）
# 本地不上传图片可不填，但填了才能测试「取凭证 → 直传」链路
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# 存储区域：新加坡为 as0（z0 华东 / z1 华北 / z2 华南 / na0 北美）
QINIU_REGION=as0

# 图片访问域名（七牛 CDN 域名，必须填）
QINIU_CDN_DOMAIN=https://img.iceuu.icu

# 上传域名一般由 REGION 自动推导，特殊情况可显式指定
# QINIU_UPLOAD_HOST=https://upload-as0.qiniup.com
