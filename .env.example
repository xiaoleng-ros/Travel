# ---------------------------------------------------------------------------
# Memora 环境变量
# 复制为 .env 后按需填写；不填的项会自动退回本地模式。
# ---------------------------------------------------------------------------

# 服务端口
PORT=3001

# 管理员账号（首次播种或覆盖已有库时生效）
ADMIN_EMAIL=admin@memora.local
ADMIN_PASSWORD=123456789
ADMIN_USERNAME=admin

# JWT 签名密钥，部署到公网时务必换成随机长字符串
JWT_SECRET=

# ---------------------------------------------------------------------------
# 数据库：Turso (libSQL)
# 留空则使用本地 data/db.json（本地开发无需配置）
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://travel-xiaoleng-ros.aws-ap-northeast-1.turso.io
# 在 Turso 控制台执行 `turso db tokens create travel-xiaoleng-ros` 生成
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# 图片存储：七牛云 Kodo
# 四项都填了才会启用七牛；否则退回本地 public/uploads
# ---------------------------------------------------------------------------
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 绑定到该空间的 CDN 加速域名，例如 https://cdn.example.com 或 https://xxxx.hn-bkt.clouddn.com
QINIU_DOMAIN=
# 上传入口，华东/华北等区域默认即可
QINIU_UPLOAD_HOST=https://upload.qiniup.com
# 对象名前缀（目录），最终 key 形如 photos/xxx.jpg
QINIU_PREFIX=photos
# 缩略图样式：七牛图片处理的 URL 参数
QINIU_THUMB_STYLE=imageView2/2/w/640/format/webp

# ---------------------------------------------------------------------------
# 高德地图（逆地理编码 + 底图，可选）
#
# 两个 Key 在控制台里是分开申请的，不能互换：
#   AMAP_KEY              JS API Key，前端加载底图用，要配 AMAP_SECURITY_CODE
#   AMAP_WEB_SERVICE_KEY  Web 服务 Key，服务端逆地理编码用（restapi.amap.com）
# 拿 JS API Key 去请求 restapi 会返回 USERKEY_PLAT_NOMATCH（10009）。
# 也可以留空，改在后台「设置 → 地图」里填。
# ---------------------------------------------------------------------------
AMAP_KEY=
AMAP_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=
