# 服务器端口
PORT=3001

# JWT 密钥（必须为32位以上的随机字符串）
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters

# 默认管理员初始密码（未设置时首次启动会随机生成并打印在控制台）
ADMIN_INITIAL_PASSWORD=123456

# 是否单独保存未经重编码的原图（默认 true；设为 false 可节省约一半存储空间，
# 但 original_url 会指向与展示图相同的压缩版本）
# KEEP_ORIGINAL=true

# 对象存储凭证加密密钥（未设置时回退使用 JWT_SECRET）
# 注意：修改此密钥会导致已保存的存储凭证无法解密
# STORAGE_ENCRYPTION_KEY=your-32-char-storage-encryption-key

# 数据库归档备份目录（默认 server/data/backups，与主库同盘）
# 建议指向另一块磁盘或异地挂载点，避免磁盘损坏时主库与备份一起丢失
# BACKUP_DIR=/backup/photo-memoir/archives

# 归档备份保留份数（默认 20，超出自动删除最旧的）
# BACKUP_KEEP=20

# 是否把数据库快照同步备份到对象存储（默认关闭）
# 为什么需要：照片本体在云上，但「哪张照片属于哪个相册、标题、拍摄时间」
# 全在 db.json 里，它一丢云端文件就成了无法归类的无名文件。
# ⚠️ 开启前提：db.json 含管理员密码哈希与加密后的存储凭证，
#    若 bucket 为「公开读」（图片走 CDN 时通常如此），备份会被任何人下载。
#    请确保备份前缀为私有读权限，或改用独立的私有 bucket。
# BACKUP_TO_CLOUD=true

# 云端备份的对象前缀（默认 backups/，务必与照片的 uploads/ 区分开）
# BACKUP_CLOUD_PREFIX=backups/

# 前端域名（用于 CORS 配置，多个域名用逗号分隔）
FRONTEND_URL=http://localhost:5173

# 反向代理信任设置（生产部署在 Nginx 之后时）
# 默认 'loopback' 仅信任本机反代；如有特殊代理拓扑，可设为数字，如 TRUST_PROXY=1
# TRUST_PROXY=loopback

# 环境模式（生产部署必须设为 production，否则 cookie 不走 secure、不托管前端产物）
NODE_ENV=development
